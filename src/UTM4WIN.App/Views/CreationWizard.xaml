<UserControl x:Class="UTM4WIN.App.Views.CreationWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="480">
        <StackPanel Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsGeneralStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="Linux x86_64 · BIOS" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="New VM name" />
                    <NumberBox Header="Virtual CPUs" Value="{x:Bind ViewModel.CpuCount, Mode=TwoWay}" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" AutomationProperties.Name="New VM CPUs" />
                    <NumberBox Header="Memory (MiB)" Value="{x:Bind ViewModel.MemoryMiB, Mode=TwoWay}" Minimum="128" Maximum="262144" SmallChange="128" SpinButtonPlacementMode="Compact" AutomationProperties.Name="New VM memory" />
                    <ComboBox Header="Execution mode" SelectedIndex="{x:Bind ViewModel.ExecutionModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="New VM execution mode">
                        <ComboBoxItem Content="WHPX virtualization" />
                        <ComboBoxItem Content="TCG emulation" />
                    </ComboBox>
                    <TextBlock Text="WHPX needs compatible Windows host capabilities. Selecting it does not enable Windows features." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsStorageStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBox Header="Linux installation ISO" Text="{x:Bind ViewModel.IsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Installation ISO path" />
                    <Button Content="Browse ISO…" Click="OnBrowseIso" />
                    <NumberBox Header="Disk capacity (GiB)" Value="{x:Bind ViewModel.DiskSizeGiB, Mode=TwoWay}" Minimum="1" Maximum="2048" SpinButtonPlacementMode="Compact" AutomationProperties.Name="New disk capacity" />
                    <TextBox Header="QEMU image tool" Text="{x:Bind ViewModel.QemuImgPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="QEMU image tool path" />
                    <Button Content="Browse qemu-img.exe…" Click="OnBrowseTool" />
                    <TextBlock Text="Select qemu-img.exe from the approved QEMU 11.1.0 installation. QEMU is supplied separately." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsReviewStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                    <CheckBox IsChecked="{x:Bind ViewModel.DiscardIncompleteDisk, Mode=TwoWay}" AutomationProperties.Name="Allow incomplete disk cleanup">
                        <TextBlock Text="Remove only this operation's incomplete disk if I cancel or creation fails." TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="Existing VM files and the ISO are preserved. Creation prepares storage and metadata; running and installing the guest will be available in the next development phase." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ProgressRing IsActive="{x:Bind ViewModel.IsCreating, Mode=OneWay}" Visibility="{x:Bind ToVisibility(ViewModel.IsCreating), Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button Content="Cancel creation" Command="{x:Bind ViewModel.CancelCreationCommand}" Visibility="{x:Bind ToVisibility(ViewModel.IsCreating), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
