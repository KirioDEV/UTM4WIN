<UserControl x:Class="UTM4WIN.App.Views.CreationWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="480" MinWidth="380" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsModeStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <TextBlock Text="Create a new virtual machine" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Click="OnVirtualize" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" AutomationProperties.Name="Virtualize">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" FontSize="32" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Virtualize" FontSize="24" />
                                <TextBlock Text="Use hardware acceleration for x86_64 guests." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Click="OnEmulate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" AutomationProperties.Name="Emulate">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" FontSize="32" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Emulate" FontSize="24" />
                                <TextBlock Text="Use software emulation. Currently supports x86_64 Linux." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <TextBlock Text="Hardware acceleration depends on the host. Selecting it does not change Windows features." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsOperatingSystemStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <TextBlock Text="Choose your guest operating system." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Click="OnLinux" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="24" AutomationProperties.Name="Linux">
                        <StackPanel Spacing="12">
                            <FontIcon Glyph="" FontSize="48" />
                            <TextBlock Text="Linux" FontSize="24" HorizontalAlignment="Center" />
                            <TextBlock Text="x86_64 · BIOS" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Windows and additional guest profiles will be added after compatibility testing." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsMediaStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <FontIcon Glyph="" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Boot from an installation ISO" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBox Header="Boot ISO image" Text="{x:Bind ViewModel.IsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Installation ISO path" />
                    <Button Content="Browse ISO…" Click="OnBrowseIso" HorizontalAlignment="Right" />
                    <TextBlock Text="Select a Linux installation image. It stays at its current location and is connected read-only." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsGeneralStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="New VM name" />
                    <NumberBox Header="Memory (MiB)" Value="{x:Bind ViewModel.MemoryMiB, Mode=TwoWay}" Minimum="128" Maximum="262144" SmallChange="128" SpinButtonPlacementMode="Compact" AutomationProperties.Name="New VM memory" />
                    <NumberBox Header="CPU cores" Value="{x:Bind ViewModel.CpuCount, Mode=TwoWay}" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" AutomationProperties.Name="New VM CPUs" />
                    <TextBlock Text="Allocate resources to the virtual machine while leaving enough available for Windows." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsStorageStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <TextBlock Text="Create a virtual drive" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <NumberBox Header="Drive size (GiB)" Value="{x:Bind ViewModel.DiskSizeGiB, Mode=TwoWay}" Minimum="1" Maximum="2048" SpinButtonPlacementMode="Compact" AutomationProperties.Name="New disk capacity" />
                    <TextBlock Text="The disk grows as the guest writes data, up to the selected capacity." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox Header="QEMU image tool" Text="{x:Bind ViewModel.QemuImgPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="QEMU image tool path" />
                    <Button Content="Browse qemu-img.exe…" Click="OnBrowseTool" HorizontalAlignment="Right" />
                    <TextBlock Text="Select qemu-img.exe from your approved QEMU 11.1.0 installation." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Visibility="{x:Bind ToVisibility(ViewModel.IsReviewStep), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                    <CheckBox IsChecked="{x:Bind ViewModel.DiscardIncompleteDisk, Mode=TwoWay}" AutomationProperties.Name="Allow incomplete disk cleanup">
                        <TextBlock Text="Remove only this operation's incomplete disk if I cancel or creation fails." TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="Creation prepares storage and metadata. Start the VM from your library in a separate QEMU window." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>
            <ProgressRing IsActive="{x:Bind ViewModel.IsCreating, Mode=OneWay}" Visibility="{x:Bind ToVisibility(ViewModel.IsCreating), Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button Content="Cancel creation" Command="{x:Bind ViewModel.CancelCreationCommand}" Visibility="{x:Bind ToVisibility(ViewModel.IsCreating), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
