<Window x:Class="UTM4WIN.App.Views.ConsoleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ConnectionStatus" Text="Connecting display…" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1" Content="Release input" Click="OnReleaseInput" />
            <Button x:Name="ReconnectButton" Grid.Column="2" Content="Reconnect display" Click="OnReconnect" />
        </Grid>
        <ContentControl x:Name="Surface" Grid.Row="1" Background="Black" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="True" AutomationProperties.Name="Guest console"
                        KeyDown="OnKeyDown" KeyUp="OnKeyUp" PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased" PointerCanceled="OnPointerCanceled" PointerCaptureLost="OnPointerCanceled" LostFocus="OnLostFocus">
            <Grid Background="Black">
                <Image x:Name="GuestImage" Stretch="Uniform" AutomationProperties.Name="Guest framebuffer" />
            </Grid>
        </ContentControl>
        <TextBlock Grid.Row="2" Text="Click the guest to send input. Ctrl+Alt+Escape releases input. Closing this console keeps the VM running." Padding="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
