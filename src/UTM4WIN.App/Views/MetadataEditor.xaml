<UserControl x:Class="UTM4WIN.App.Views.MetadataEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="480">
        <StackPanel Spacing="12">
            <TextBlock Text="Save VM metadata now. Installation media and a virtual disk are added in the creation workflow." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="VM name" />
            <NumberBox Header="Virtual CPUs" Value="{x:Bind ViewModel.CpuCount, Mode=TwoWay}" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Virtual CPUs" />
            <NumberBox Header="Memory (MiB)" Value="{x:Bind ViewModel.MemoryMiB, Mode=TwoWay}" Minimum="128" Maximum="262144" SmallChange="128" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Memory in MiB" />
            <ComboBox Header="Execution mode" SelectedIndex="{x:Bind ViewModel.ExecutionModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Execution mode">
                <ComboBoxItem Content="WHPX virtualization" />
                <ComboBoxItem Content="TCG emulation" />
            </ComboBox>
            <TextBlock Text="x86_64 Linux · BIOS. Host availability is checked before a future VM start; selecting WHPX does not enable Windows features." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
