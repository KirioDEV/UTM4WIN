<UserControl x:Class="UTM4WIN.App.Views.MetadataEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:domain="using:UTM4WIN.Domain">
    <Grid MinWidth="400" MinHeight="320" MaxHeight="480" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox SelectedIndex="{x:Bind ViewModel.SectionIndex, Mode=TwoWay}" AutomationProperties.Name="VM settings categories">
            <ListBoxItem Content="Information" />
            <ListBoxItem Content="System" />
            <ListBoxItem Content="Drives" />
            <ListBoxItem Content="Network" />
            <ListBoxItem Content="Display" />
        </ListBox>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <StackPanel Visibility="{x:Bind ToVisibility(ViewModel.IsInfoSection), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="Information" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="VM name" />
                    <TextBlock Text="Linux x86_64" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="This name identifies the virtual machine in your library." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Visibility="{x:Bind ToVisibility(ViewModel.IsSystemSection), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="System" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Standard PC · x86_64 · BIOS" TextWrapping="Wrap" />
                    <NumberBox Header="Memory (MiB)" Value="{x:Bind ViewModel.MemoryMiB, Mode=TwoWay}" Minimum="128" Maximum="262144" SmallChange="128" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Memory in MiB" />
                    <NumberBox Header="CPU cores" Value="{x:Bind ViewModel.CpuCount, Mode=TwoWay}" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Virtual CPUs" />
                    <ComboBox Header="Execution mode" SelectedIndex="{x:Bind ViewModel.ExecutionModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Execution mode">
                        <ComboBoxItem Content="WHPX virtualization" />
                        <ComboBoxItem Content="TCG emulation" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Visibility="{x:Bind ToVisibility(ViewModel.IsDrivesSection), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="Drives" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DriveSummary}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.OriginalConfiguration.Storage}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:StorageResource">
                                <Border Padding="12" Margin="0,0,0,8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Format}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Ownership}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Drive changes are not available yet." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Visibility="{x:Bind ToVisibility(ViewModel.IsNetworkSection), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="Network" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.NetworkLabel}" />
                    <TextBlock Text="Network configuration changes are not available yet." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Visibility="{x:Bind ToVisibility(ViewModel.IsDisplaySection), Mode=OneWay}" Spacing="16">
                    <TextBlock Text="Display" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="UTM4WIN console" />
                    <TextBlock Text="The console uses an authenticated local display connection. Closing it keeps the VM running." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
