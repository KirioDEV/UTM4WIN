<Window x:Class="UTM4WIN.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:UTM4WIN.App.ViewModels" Title="UTM4WIN">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneTitle="UTM4WIN" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" SelectionChanged="OnNavigationChanged" Header="{x:Bind ViewModel.SectionTitle, Mode=OneWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LibraryItem" Content="Virtual machines" Icon="AllApps" AutomationProperties.Name="Virtual machines" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <TextBlock Text="UTM4WIN" Margin="16,12" Style="{StaticResource CaptionTextBlockStyle}" />
            </NavigationView.PaneFooter>
            <Grid Padding="24">
                <Grid Visibility="{x:Bind ToVisibility(ViewModel.IsLibrarySelected), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Create VM" Command="{x:Bind Library.CreateCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Add metadata" Command="{x:Bind Library.AddCommand}" />
                        <Button Content="Edit" Command="{x:Bind Library.EditCommand}" />
                        <Button Content="Remove entry" Command="{x:Bind Library.RemoveCommand}" />
                        <Button Content="Reload" Command="{x:Bind Library.ReloadCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,12" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Library.IsBusy, Mode=OneWay}" Visibility="{x:Bind ToVisibility(Library.IsBusy), Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" AutomationProperties.Name="Library operation in progress" />
                        <TextBlock x:Name="LibraryError" Text="{x:Bind Library.Error, Mode=OneWay}" TextWrapping="Wrap" MaxHeight="120" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Visibility="{x:Bind ToVisibility(Library.IsEmpty), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460">
                        <FontIcon Glyph="" FontSize="48" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Your virtual machines, in one place" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Your library is empty." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                    </StackPanel>
                    <ListView Grid.Row="2" ItemsSource="{x:Bind Library.Machines}" SelectedItem="{x:Bind Library.SelectedMachine, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="VM metadata library">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VmListItem">
                                <StackPanel Spacing="4" Margin="4,8">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Visibility="{x:Bind ToVisibility(Library.HasRetainedEntries), Mode=OneWay}" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Retained metadata or incomplete creation: files are preserved." TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{x:Bind Library.RetainedIds}" SelectedItem="{x:Bind Library.SelectedRetainedId, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Retained VM ID" />
                        <Button Content="Register retained metadata" Command="{x:Bind Library.RegisterCommand}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Visibility="{x:Bind ToVisibility(ViewModel.IsSettingsSelected), Mode=OneWay}">
                    <StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="ThemePicker" Header="App theme" Width="260" SelectedIndex="0" SelectionChanged="OnThemeChanged" AutomationProperties.Name="App theme">
                            <ComboBoxItem Content="Use Windows setting" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                        <TextBlock Text="Appearance changes apply to this session." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
