<Window x:Class="UTM4WIN.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:UTM4WIN.App.ViewModels" xmlns:domain="using:UTM4WIN.Domain" Title="UTM4WIN">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="OnRootSizeChanged">
        <SplitView x:Name="LibrarySplit" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="270" PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
            <SplitView.Pane>
                <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="18,16,10,14">
                        <TextBlock Text="Virtual machines" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button HorizontalAlignment="Right" Command="{x:Bind Library.CreateCommand}" AutomationProperties.Name="Create VM" ToolTipService.ToolTip="Create a virtual machine" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="" FontSize="16" />
                        </Button>
                    </Grid>
                    <ListView x:Name="MachineList" Grid.Row="1" ItemsSource="{x:Bind Library.Machines}" SelectedItem="{x:Bind Library.SelectedMachine, Mode=TwoWay}" SelectionMode="Single" SelectionChanged="OnMachineSelectionChanged" Padding="8,0" AutomationProperties.Name="Virtual machine library">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VmListItem">
                                <Grid Padding="2,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="" FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Padding="12" Spacing="8">
                        <Button x:Name="LibraryItem" Content="Virtual machines" Click="OnLibraryClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" />
                        <Button x:Name="SettingsItem" Content="App settings" Click="OnSettingsClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </SplitView.Pane>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SidebarToggle" Click="OnSidebarToggle" AutomationProperties.Name="Toggle VM sidebar" ToolTipService.ToolTip="Show or hide virtual machines" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="" FontSize="16" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="UTM4WIN" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Library.SelectedMachine.Name, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Command="{x:Bind Library.EditCommand}" AutomationProperties.Name="VM settings" ToolTipService.ToolTip="Virtual machine settings" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="" FontSize="17" />
                        </Button>
                        <Button x:Name="LibraryMenuButton" AutomationProperties.Name="Library actions" ToolTipService.ToolTip="Library actions" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="" FontSize="17" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Create VM" Command="{x:Bind Library.CreateCommand}" />
                                    <MenuFlyoutItem Text="Add metadata" Command="{x:Bind Library.AddCommand}" />
                                    <MenuFlyoutItem Text="Reload library" Command="{x:Bind Library.ReloadCommand}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Remove entry" Command="{x:Bind Library.RemoveCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="4" Margin="16,0">
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ToVisibility(Library.IsBusy), Mode=OneWay}" Height="3" AutomationProperties.Name="Library operation in progress" />
                    <TextBlock x:Name="LibraryError" Text="{x:Bind Library.Error, Mode=OneWay}" TextWrapping="Wrap" MaxHeight="100" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Grid Grid.Row="2" Visibility="{x:Bind ToVisibility(ViewModel.IsLibrarySelected), Mode=OneWay}">
                    <ScrollViewer Visibility="{x:Bind ToVisibility(Library.HasSelectedMachine), Mode=OneWay}" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border x:Name="Preview" Background="{ThemeResource LayerFillColorAltBrush}" SizeChanged="OnPreviewSizeChanged" MinHeight="190" MaxHeight="420">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="24">
                                    <Button IsEnabled="False" AutomationProperties.Name="Run VM unavailable" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="VM execution is not available yet">
                                        <FontIcon Glyph="" FontSize="64" />
                                    </Button>
                                    <TextBlock Text="No saved display" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="VM execution is not available yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Grid Padding="24,20" RowSpacing="16" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Status" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Library.SelectedMachine.StatusLabel, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="Architecture" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="x86_64" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2" Text="Machine" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Standard PC · BIOS" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="Memory" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Library.SelectedMachine.MemoryLabel, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="4" Text="CPU" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind Library.SelectedMachine.CpuLabel, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="5" Text="Execution" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind Library.SelectedMachine.ExecutionLabel, Mode=OneWay}" HorizontalAlignment="Right" TextWrapping="Wrap" />
                            </Grid>
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Drives" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Library.SelectedMachine.StorageLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind Library.SelectedMachine.Storage, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="domain:StorageResource">
                                                <Grid Padding="0,8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="" FontSize="16" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Visibility="{x:Bind ToVisibility(Library.NoSelectedMachine), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="16" Padding="24">
                        <FontIcon Glyph="" FontSize="56" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="UTM4WIN" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Create a new virtual machine or select one from the sidebar." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Create a new virtual machine" Command="{x:Bind Library.CreateCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border Visibility="{x:Bind ToVisibility(Library.HasRetainedEntries), Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Padding="12" MaxWidth="400" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Retained virtual machine files" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox ItemsSource="{x:Bind Library.RetainedIds}" SelectedItem="{x:Bind Library.SelectedRetainedId, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Retained VM ID" />
                            <Button Content="Register retained metadata" Command="{x:Bind Library.RegisterCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer Grid.Row="2" Visibility="{x:Bind ToVisibility(ViewModel.IsSettingsSelected), Mode=OneWay}">
                    <StackPanel Spacing="16" Margin="28" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="App settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="ThemePicker" Header="Appearance" Width="260" SelectedIndex="0" SelectionChanged="OnThemeChanged" AutomationProperties.Name="App theme">
                            <ComboBoxItem Content="Use Windows setting" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                        <TextBlock Text="Appearance changes apply to this session." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </SplitView>
    </Grid>
</Window>